# Скопируйте в .env и заполните: cp .env.example .env

# Токен бота из кабинета business.max.ru, раздел «Интеграция» (обязательно).
MAX_BOT_TOKEN=

# Необязательные настройки (значения по умолчанию указаны в README):
# LOG_LEVEL=debug
# WORKERS=32
# SESSION_TTL=4320h

# Webhook вместо long polling. На проде WEBHOOK_URL задан в
# deploy/docker-compose.prod.yml, а локально бот работает через long polling.
# WEBHOOK_URL=https://example.ru/webhook
# WEBHOOK_SECRET=   # openssl rand -hex 32
# HTTP_ADDR=:8080

# ID пользователей MAX через запятую, которые разбирают черновики агента.
# ADMIN_IDS=

# Пароль Postgres для Docker Compose; локально по умолчанию benefits.
# POSTGRES_PASSWORD=

# ── Агент для наполнения базы (go run ./cmd/agent) ──
# Бесплатно: поиск через локальный SearXNG, модель через Ollama.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:14b
#
# Или Yandex Cloud: один ключ для поиска и модели (см. README).
# По умолчанию YandexGPT Pro 5.1 в асинхронном режиме: вдвое дешевле.
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# Для открытых моделей AI Studio асинхронного режима нет:
# LLM_MODEL=gpt://<каталог>/qwen3-235b-a22b-fp8
# YANDEX_ASYNC=false
#
# Сколько токенов модели можно потратить за прогон, 0 — без лимита.
# LLM_TOKEN_LIMIT=300000
